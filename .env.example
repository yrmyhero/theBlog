# MySQL 配置
MYSQL_ROOT_PASSWORD=change_me_root_pwd
MYSQL_DATABASE=mydb
MYSQL_USER=myuser
MYSQL_PASSWORD=change_me_user_pwd

# JWT 密钥（用 python -c "import secrets; print(secrets.token_urlsafe(32))" 生成）
SECRET_KEY=change_me_to_random_string

# Docker Hub 用户名（不推镜像可以不设）
DOCKER_USER=your_dockerhub_username
